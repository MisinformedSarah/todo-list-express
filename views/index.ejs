<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta http-equiv="X-UA-Compatible" content="IE=edge">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Document</title>
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/5.15.3/css/all.min.css">
    <link rel="stylesheet" href="css/style.css">
</head>
<body>
    <!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta http-equiv="X-UA-Compatible" content="IE=edge">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Document</title>
</head>
<body>
    <h1>Todo List: </h1>
   
    
    <ul>
        
        <% infoComplete.forEach(item => { %>
            <li class="item">
                <span class="completed"><%= item.thing %></span>
                <button class="fa-trash">delete</button>
                </li>
          <% }) %>
        
    </ul>
    <h1>Not Done</h1>
     <ul>
       <% infoNotComplete.forEach(item => { %>
                <li class="item">
                <span><%= item.thing %></span>
                <button class="fa-trash">delete</button>
                </li>

         <% }) %>

    </ul>

    


   

    <h2>Add A Todo:</h2>

    <form action="/addTodo" method="POST">
        <input type="text" placeholder="Thing To Do" name="todoItem" class="addTodo">
        <input type="submit">
    </form>
    

    <script src='js/main.js'></script>
</body>
</html>
