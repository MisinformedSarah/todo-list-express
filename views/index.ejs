<body>
    <!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta http-equiv="X-UA-Compatible" content="IE=edge">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Document</title>
</head>
<body>
    <h1>Todo List: </h1>
   
    
    <ul>
        <li class=""> 
        <% for(let i=0; i<infoComplete.length;i++){%>
            <%if(infoComplete[i]){%>
                <span><%= infoComplete[i].thing %></span>
            <%}else{%>
                <span>erorr</span>
            <%}%>
        <%}%>
        </li>
    </ul>
    <h1>Not Done</h1>
     <ul>
        <li class=""> 
        <% for(let i=0; i<infoNotComplete.length;i++){%>
            <%if(infoNotComplete[i]){%>
                <span><%= infoNotComplete[i].thing %></span>
            <%}else{%>
                <span>erorr</span>
            <%}%>
        <%}%>
        </li>
    </ul>

    


   

    <h2>Add A Todo:</h2>

    <form action="/addTodo" method="POST">
        <input type="text" placeholder="Thing To Do" name="todoItem">
        <input type="submit">
    </form>
    

    <script src='js/main.js'></script>
</body>
</html>
